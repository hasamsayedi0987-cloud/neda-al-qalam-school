# ─── نمونهٔ متغیرهای محیطی — مکتب خصوصی نداالقلم ───
# این فایل را به .env کپی کنید و مقادیر را تنظیم کنید

# پایگاه داده:
# حالت محلی (SQLite):
# DATABASE_URL="file:./db/custom.db"
# حالت ابری (Vercel + Neon/PostgreSQL) — خودکار توسط یکپارچهٔ Storage تزریق می‌شود
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# کلید امضای کوکی نشست (توصیه: یک رشتهٔ تصادفی طولانی بگذارید)
AUTH_SECRET="neda-ol-qalam-school-secret-1405"
