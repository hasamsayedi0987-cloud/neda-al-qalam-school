generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ═══════════════ کاربران و احراز هویت ═══════════════

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String // scrypt hash
  name      String
  role      String // ADMIN | HEADTEACHER | TEACHER | STUDENT | GUARDIAN | STAFF | LIBRARIAN
  active    Boolean  @default(true)
  phone     String?
  teacherId String? @unique // پیوند با معلم/کارمند
  studentId String? // پیوند با شاگرد (برای والد/سرپرست)
  perms     String? // JSON — دسترسی بخش‌ها (رونویسی نقش): {"grades": false, "library": true}
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications Notification[]
  sentMessages Message[] @relation("sentMessages")
  messageRecipients MessageRecipient[]
  guardianLinks GuardianLink[]
  teacherProfile Teacher?  @relation(fields: [teacherId], references: [id])
  studentProfile Student?  @relation("StudentUsers", fields: [studentId], references: [id])
}

// ═══════════════ ساختار تعلیمی ═══════════════

model Class {
  id           String   @id @default(cuid())
  grade        Int // ۱ تا ۱۲
  name         String // صنف اول، صنف دوم ...
  capacity     Int? // ظرفیت صنف — هشدار در صورت پر شدن
  monthlyFee   Float? // فیس ماهانهٔ پیش‌فرض این صنف (افغانی)
  supervisorId String? // نگران صنف (معلم)
  actingSupervisorId String? // نگران موقت (در غیاب نگران اصلی — تعیین توسط مدیر)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  supervisor    Teacher?       @relation("supervisor", fields: [supervisorId], references: [id])
  actingSupervisor Teacher?     @relation("actingSupervisor", fields: [actingSupervisorId], references: [id])
  students      Student[]
  classSubjects ClassSubject[]
  scheduleSlots ScheduleSlot[]
}

model Subject {
  id        String   @id @default(cuid())
  name      String
  code      String? // کد اختصاصی مضمون (برای کارنامه و اسناد)
  credits   Int? // تعداد واحد درسی
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classSubjects ClassSubject[]
  scheduleSlots ScheduleSlot[]
}

// تقسیم مضامین به صنف و معلم
model ClassSubject {
  id        String   @id @default(cuid())
  classId   String
  subjectId String
  teacherId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class    Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject  Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher  Teacher? @relation(fields: [teacherId], references: [id])
  grades   Grade[]

  @@unique([classId, subjectId])
}

// برنامهٔ هفتگی صنف‌ها — با هشدار تداخل زمانی معلم
model ScheduleSlot {
  id        String  @id @default(cuid())
  classId   String
  subjectId String
  teacherId String?
  day       Int     // ۰=شنبه … ۵=جمعه
  period    Int     // پریود دورهٔ درسی (۱، ۲، …)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class   Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher Teacher?      @relation(fields: [teacherId], references: [id])

  @@unique([classId, day, period])
  @@index([teacherId, day, period])
}

// ═══════════════ اشخاص ═══════════════

model Teacher {
  id         String   @id @default(cuid())
  name       String
  fatherName String?
  position   String   @default("معلم") // معلم | سرمعلم | مدیر | ملازم | کارمند | کتابخانه‌دار
  phone      String?
  education  String?
  hireDate   String? // تاریخ شمسی
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user             User?
  supervised       Class[]        @relation("supervisor")
  actingClasses    Class[]        @relation("actingSupervisor")
  classSubjects    ClassSubject[]
  scheduleSlots    ScheduleSlot[]
  attendances      StaffAttendance[]
  tasks            StaffTask[]    @relation("assignedTo")
  assignedTasks    StaffTask[]    @relation("assignedBy")
}

model Student {
  id            String   @id @default(cuid())
  firstName     String // اسم
  lastName      String? // شهرت/تخلص — اختیاری
  fatherName    String // ولد
  grandFather   String? // ولدیت
  gender        String   @default("M") // M | F
  birthDate     String? // تاریخ شمسی
  idNumber      String? // نمبر تذکره
  guardianName  String?
  guardianPhone String?
  address       String?
  photo         String? // عکس شاگرد (dataURL فشرده)
  classId       String?
  rollNo        Int? // شماره در جدول
  status        String   @default("ACTIVE") // ACTIVE | LEFT | GRADUATED
  enrolledYear  String? // سال شمولیت
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  class      Class?            @relation(fields: [classId], references: [id])
  attendance AttendanceRecord[]
  activities StudentActivity[]
  grades     Grade[]
  loans      BookLoan[]
  feePayments FeePayment[]
  users      User[] @relation("StudentUsers")
  guardianLinks GuardianLink[]
}

// ═══════════════ حاضری ═══════════════

model AttendanceRecord {
  id         String   @id @default(cuid())
  studentId  String
  classId    String
  date       String // ISO یومیه: yyyy-mm-dd
  status     String // PRESENT | ABSENT | SICK | LEAVE
  recordedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([classId, date])
}

model StaffAttendance {
  id        String   @id @default(cuid())
  teacherId String
  date      String // ISO
  status    String // PRESENT | ABSENT | SICK | LEAVE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, date])
}

// ═══════════════ فعالیت‌های شاگرد ═══════════════

model StudentActivity {
  id         String   @id @default(cuid())
  studentId  String
  date       String // ISO
  type       String // HOMEWORK | BEHAVIOR | PARTICIPATION | OTHER
  score      Int? // نمره یا امتیاز ۰-۱۰۰
  note       String
  image      String? // عکس فعالیت (dataURL فشرده — اختیاری)
  recordedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// ═══════════════ نمرات ═══════════════

model Grade {
  id             String   @id @default(cuid())
  studentId      String
  classSubjectId String
  period         String // MIDTERM | ANNUAL
  written        Float? // تحریری
  oral           Float? // تقریری/عملی
  homework       Float? // کارخانگی
  activity       Float? // فعالیت صنفی
  total          Float    @default(0) // مجموع محاسبه‌شده
  approved       Boolean  @default(false)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classSubject ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, classSubjectId, period])
}

// ═══════════════ کتابخانه ═══════════════

model Book {
  id        String   @id @default(cuid())
  title     String
  author    String?
  category  String?
  copies    Int      @default(1)
  available Int      @default(1)
  shelfNo   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loans BookLoan[]
}

model BookLoan {
  id           String   @id @default(cuid())
  bookId       String
  borrowerName String
  borrowerType String   @default("STUDENT") // STUDENT | TEACHER | STAFF
  studentId    String?
  loanDate     String
  dueDate      String
  returnDate   String?
  status       String   @default("LENT") // LENT | RETURNED
  fineAmount   Float? // جریمهٔ دیرکرد (ثبت هنگام پس‌دادن)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  book    Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id])
}

// ═══════════════ اعلان‌ها ═══════════════

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String   @default("INFO") // INFO | SUCCESS | WARNING | GRADE | ATTENDANCE
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ═══════════════ وظایف کارمندان ═══════════════

model StaffTask {
  id          String   @id @default(cuid())
  staffId     String
  title       String
  description String?
  dueDate     String?
  status      String   @default("PENDING") // PENDING | IN_PROGRESS | DONE
  assignedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff      Teacher? @relation("assignedTo", fields: [staffId], references: [id])
  assigner   Teacher? @relation("assignedBy", fields: [assignedBy], references: [id])
}

// ═══════════════ مدیریت مالی و فیس ═══════════════

model FeePayment {
  id         String   @id @default(cuid())
  studentId  String
  month      String   // ماه شمسی «1405-10»
  amount     Float    // مبلغ پرداختی (افغانی)
  paidAt     String   // تاریخ پرداخت ISO yyyy-mm-dd
  method     String   @default("CASH") // CASH | BANK
  note       String?
  recordedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, month])
  @@index([month])
}

// ═══════════════ پیام‌ها و ارتباطات ═══════════════

model Message {
  id        String   @id @default(cuid())
  fromUserId String
  toUserId  String?  // مستقیم تک‌نفره (سازگاری با پیام‌های قدیمی) — برای پیام همگانی null است
  toRole    String?  // همگانی به یک نقش (ADMIN | TEACHER | GUARDIAN | …)
  toClassId String?  // همگانی به والدین یک صنف
  subject   String?
  body      String
  category  String   @default("GENERAL") // GENERAL | ACADEMIC | DISCIPLINARY | ANNOUNCEMENT
  kind      String   @default("DIRECT") // DIRECT | GROUP | BROADCAST
  priority  String   @default("NORMAL") // NORMAL | URGENT
  attachment String? // JSON {name,type,data} — پیوست فایل/عکس (در صورت فعال بودن از پنل مدیر)
  read      Boolean  @default(false) // برای پیام مستقیم قدیمی — جدید: وضعیت در MessageRecipient
  editedAt  DateTime? // ویرایش پیام توسط فرستنده (پنجرهٔ محدود)
  deletedFor String? // JSON آرایهٔ شناسهٔ کاربرانی که این پیام را برای خودشان حذف کرده‌اند
  createdAt DateTime @default(now())

  fromUser User @relation("sentMessages", fields: [fromUserId], references: [id], onDelete: Cascade)
  recipients MessageRecipient[]

  @@index([toUserId, read])
  @@index([fromUserId])
}

// گیرندگان واقعی هر پیام — وضعیت خوانده‌شدن و حذف به‌ازای هر فرد
model MessageRecipient {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  read      Boolean  @default(false)
  readAt    DateTime?
  deleted   Boolean  @default(false) // حذف فقط برای همین گیرنده
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, read])
  @@index([messageId])
}

// پیوند والد با فرزندان — یک سرپرست می‌تواند چند شاگرد (در صنف‌های مختلف) داشته باشد
model GuardianLink {
  id        String   @id @default(cuid())
  userId    String
  studentId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([userId, studentId])
  @@index([userId])
  @@index([studentId])
}

// گزارش فعالیت‌های حساس — تغییر صلاحیت‌های ارتباطی و مودریشن پیام‌ها
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actorName String
  action    String // COMM_POLICY_UPDATE | MSG_MODERATE_DELETE | GUARDIAN_LINK_…
  detail    String   @default("{}") // JSON توضیح اقدام
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ═══════════════ تنظیمات (کلید-مقدار) ═══════════════

model Setting {
  key   String @id
  value String
}

// ═══════════════ بخش‌های دلخواه (ساخته‌شده توسط مدیر) ═══════════════

model CustomSection {
  id        String   @id @default(cuid())
  title     String
  icon      String   @default("Sparkles") // نام آیکون lucide
  color     String   @default("emerald")
  fields    String   @default("[]") // JSON: [{key,label,type,options,required}]
  viewRoles String   @default("[\"ADMIN\",\"HEADTEACHER\",\"TEACHER\"]") // چه کسی می‌بیند
  writeRoles String  @default("[\"ADMIN\",\"HEADTEACHER\",\"TEACHER\"]") // چه کسی ثبت می‌کند
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries CustomEntry[]
}

model CustomEntry {
  id        String   @id @default(cuid())
  sectionId String
  data      String   @default("{}") // JSON: مقادیر فیلدها
  entryDate String? // تاریخ شمسی اختیاری
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section CustomSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
}

// ═══════════════ قالب‌های تقدیرنامه ═══════════════

model CertificateTemplate {
  id        String   @id @default(cuid())
  name      String
  config    String   @default("{}") // JSON: طراحی کامل
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
